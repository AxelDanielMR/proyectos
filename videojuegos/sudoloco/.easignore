# EAS Build ignore file - exclude files and directories that are not needed for building

# Dependencies - will be reinstalled on the build server
node_modules/

# Version control
.git/
.gitignore

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Build outputs and cache
dist/
build/
.next/
.expo/
.gradle/

# Android build - exclude entire android directory as it will be regenerated
android/

# iOS build
ios/build/
ios/Pods/

# Environment and local config
.env
.env.local
.env.*.local

# OS files
Thumbs.db

# Testing
coverage/
.nyc_output/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
tmp/
temp/
*.tmp

# Documentation
docs/

# Large files that aren't needed for build
*.psd
*.mp4
*.mov
*.m4a
*.mp3
